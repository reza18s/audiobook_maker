AUDIOBOOK_API_TOKEN=replace-with-a-long-random-token
GATEWAY_BIND_ADDRESS=127.0.0.1
MEDIA_WORKER_EXTERNAL=1
# Engine images are only needed when starting with --profile engines.
DEBUG_TTS_IMAGE=audiobook-maker-debug-tts:latest
F5TTS_IMAGE=audiobook-maker-f5tts:latest
CHATTERBOX_IMAGE=audiobook-maker-chatterbox:latest
VIBEVOICE_IMAGE=audiobook-maker-vibevoice:latest
XTTS_IMAGE=audiobook-maker-xtts:latest
F5_GPU_ID=0
CHATTERBOX_GPU_ID=0
VIBEVOICE_GPU_ID=0
XTTS_GPU_ID=0
MEDIA_POLL_SECONDS=1
ENGINE_WORKER_POLL_SECONDS=1
ENGINE_REQUEST_TIMEOUT_SECONDS=900
ENGINE_DISCOVERY_TIMEOUT_SECONDS=2
